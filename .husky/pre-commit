# Commit'lenmek üzere STAGE'lenmiş değişikliklerde sır taraması.
# Yalnızca staged diff taranır (tüm geçmiş değil) — hızlı olsun diye.
# CI'da aynı kontrol tekrar çalışır (bkz. .github/workflows/ci.yml
# "sir-taramasi"); bu hook yalnızca erken/yerel geri bildirim içindir.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo ""
  echo "❌ gitleaks bulunamadı — commit öncesi sır taraması yapılamıyor."
  echo ""
  echo "   Kurulum:"
  echo "     macOS : brew install gitleaks"
  echo "     Linux : https://github.com/gitleaks/gitleaks/releases"
  echo "             (gitleaks_<sürüm>_linux_x64.tar.gz indirip PATH'e koyun)"
  echo "     Go    : go install github.com/zricethezav/gitleaks/v8@latest"
  echo ""
  echo "   Kontrol SESSİZCE ATLANMAZ: sır taraması yapılmadan commit"
  echo "   almıyoruz. Gerçekten gerekiyorsa 'git commit --no-verify' ile"
  echo "   geçebilirsiniz — ama CI'daki tarama yine de sizi durduracaktır."
  echo ""
  exit 1
fi

gitleaks git --staged --redact --no-banner --config .gitleaks.toml || {
  echo ""
  echo "❌ Commit engellendi: stage'lenmiş değişikliklerde olası sır bulundu."
  echo "   Değerler yukarıda maskelenmiştir (--redact)."
  echo ""
  echo "   • Gerçek bir sırsa: dosyadan çıkarın, .env.local gibi"
  echo "     git'e girmeyen bir dosyaya taşıyın."
  echo "   • Yanlış pozitifse: .gitleaks.toml'daki allowlist'e ekleyin ya da"
  echo "     ilgili satıra 'gitleaks:allow' yorumu koyun."
  echo ""
  exit 1
}
