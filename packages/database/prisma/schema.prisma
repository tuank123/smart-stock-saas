// ============================================
// REVERSE SYNC QUEUE
// ============================================

model SyncQueue {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  direction     String    @default("OUTBOUND")
  operationType String    @map("operation_type")
  payload       Json
  adapterType   String    @map("adapter_type")
  status        String    @default("PENDING")
  attemptCount  Int       @default(0) @map("attempt_count")
  lastAttemptAt DateTime? @map("last_attempt_at")
  errorMessage  String?   @map("error_message")
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  tenant  Tenant    @relation(fields: [tenantId], references: [id])
  branch  Branch    @relation(fields: [branchId], references: [id])
  creator User?     @relation("SyncQueueCreator", fields: [createdBy], references: [id])
  logs    SyncLog[]

  @@index([tenantId])
  @@index([branchId, status])
  @@map("sync_queue")
}

model SyncLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  queueId         String   @map("queue_id") @db.Uuid
  attemptNumber   Int      @map("attempt_number")
  direction       String
  requestPayload  String?  @map("request_payload")
  responsePayload String?  @map("response_payload")
  status          String
  errorDetail     String?  @map("error_detail")
  executedAt      DateTime @default(now()) @map("executed_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  syncQueue SyncQueue @relation(fields: [queueId], references: [id])

  @@index([tenantId])
  @@index([queueId])
  @@map("sync_logs")
}

// ============================================
// SUPPLIER PORTAL
// ============================================

model BranchSupplierPortal {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  subdomain String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant                 @relation(fields: [tenantId], references: [id])
  branch  Branch                 @relation(fields: [branchId], references: [id])
  uploads SupplierPortalUpload[]

  @@unique([branchId])
  @@index([subdomain])
  @@map("branch_supplier_portals")
}

model SupplierPortalUpload {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  branchId          String    @map("branch_id") @db.Uuid
  supplierId        String?   @map("supplier_id") @db.Uuid
  portalId          String?   @map("portal_id") @db.Uuid
  uploaderPhone     String    @map("uploader_phone")
  otpVerifiedAt     DateTime? @map("otp_verified_at")
  pdfUrl            String?   @map("pdf_url")
  ocrExtractedFirm  String?   @map("ocr_extracted_firm")
  ocrExtractedPhone String?   @map("ocr_extracted_phone")
  effectivePhone    String    @map("effective_phone")
  ocrStatus         String?   @default("PENDING") @map("ocr_status")
  uploadType        String    @map("upload_type")
  status            String    @default("PENDING_REVIEW") @map("status")
  reviewedBy        String?   @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at")
  parsedItems       Json?     @map("parsed_items") // [{ productId, productName, oldPrice, newPrice, discountPct }]
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  branch   Branch                @relation(fields: [branchId], references: [id])
  portal   BranchSupplierPortal? @relation(fields: [portalId], references: [id])
  supplier Supplier?             @relation(fields: [supplierId], references: [id])
  reviewer User?                 @relation("PortalReviewer", fields: [reviewedBy], references: [id])

  @@index([tenantId])
  @@index([branchId, status])
  @@map("supplier_portal_uploads")
}

// ============================================
// REPORTING
// ============================================

model ScheduledReport {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  reportType  String    @map("report_type")
  reportDate  DateTime  @map("report_date") @db.Date
  generatedAt DateTime  @default(now()) @map("generated_at")
  payload     Json
  pdfUrl      String?   @map("pdf_url")
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([tenantId, reportType, reportDate])
  @@index([tenantId, isRead])
  @@map("scheduled_reports")
}

model PriceChangeLog {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  branchId            String?  @map("branch_id") @db.Uuid
  oldPrice            Decimal  @map("old_price") @db.Decimal(12, 2)
  newPrice            Decimal  @map("new_price") @db.Decimal(12, 2)
  changePct           Decimal  @map("change_pct") @db.Decimal(5, 2)
  categoryAvgIncrease Decimal? @map("category_avg_increase") @db.Decimal(5, 2)
  anomalyFlag         Boolean  @default(false) @map("anomaly_flag")
  anomalyRatio        Decimal? @map("anomaly_ratio") @db.Decimal(5, 2)
  changedBy           String   @map("changed_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])
  changer User    @relation(fields: [changedBy], references: [id])

  @@index([tenantId])
  @@index([tenantId, anomalyFlag])
  @@map("price_change_logs")
}

/// Platform geneli hata/başarısız işlem toplama (super-admin sistem tablosu, RLS'siz).
model ErrorLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source     String // 'API_EXCEPTION' | 'SYNC_JOB' | 'LOGIN_FAILED' | 'OCR_SCAN' | 'WHATSAPP_WEBHOOK' | 'SECURITY_EVENT' | 'DATA_INTEGRITY' | 'SCHEDULED_JOB' | 'FRONTEND_ERROR'
  severity   String    @default("ERROR") // 'ERROR' | 'WARNING'
  message    String
  stackTrace String?   @map("stack_trace")
  tenantId   String?   @map("tenant_id") @db.Uuid
  branchId   String?   @map("branch_id") @db.Uuid
  context    Json?
  resolved   Boolean   @default(false)
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([resolved, createdAt])
  @@index([source])
  @@map("error_logs")
}

/// Teknik olmayan kullanıcı geri bildirimi/şikayeti (ErrorLog'un kapsamadığı
/// ürün/deneyim geri bildirimleri). Yalnızca tek şubeli (STARTER) PATRON
/// gönderebilir (bkz. feedback.service.ts) — RLS YOK, ErrorLog ile aynı
/// gerekçe: SUPER_ADMIN admin panelinden tüm tenant'ların kaydını okur.
model UserFeedback {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  subject   String
  message   String
  status    String    @default("NEW") // 'NEW' | 'READ'
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("user_feedback")
}

/// Şifre sıfırlama token'ları (tek kullanımlık, 1 saat geçerli; RLS'siz sistem tablosu —
/// sahibi oturum açmamış kullanıcıdır, tenant bağlamı yoktur).
model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@map("password_reset_tokens")
}

/// E-posta doğrulama token'ları (tek kullanımlık, 24 saat geçerli; RLS'siz sistem tablosu).
model EmailVerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@map("email_verification_tokens")
}
