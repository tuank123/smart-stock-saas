// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum TenantPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  SUPER_ADMIN
  PATRON
  SUBE_MUDURU
  KASIYER
  DEPO
}

enum StaffTokenStatus {
  PENDING
  APPROVED
  USED
  CANCELLED
}

// ============================================
// CORE TABLES
// ============================================

/// Multi-tenant root entity
model Tenant {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId      TenantPlan   @default(STARTER) @map("plan_id")
  companyName String       @map("company_name")
  taxNumber   String       @unique @map("tax_number")
  status      TenantStatus @default(ACTIVE)
  settings    Json? // flexible config storage

  // Relations
  users                   User[]
  branches                Branch[]
  staffRegistrationTokens StaffRegistrationToken[]
  branchIntegrations      BranchIntegration[]
  categories              Category[]
  products                Product[]
  stockLevels             StockLevel[]
  stockMovements          StockMovement[]
  suppliers               Supplier[]
  purchaseOrders          PurchaseOrder[]
  stockTransfers          StockTransfer[]
  whatsappMessageLogs     WhatsappMessageLog[]
  ocrScans                OcrScan[]
  syncQueues              SyncQueue[]
  syncLogs                SyncLog[]
  branchSupplierPortals   BranchSupplierPortal[]
  supplierPortalUploads   SupplierPortalUpload[]
  scheduledReports        ScheduledReport[]
  priceChangeLogs         PriceChangeLog[]
  cashierSessions         CashierSession[]
  debts                   Debt[]
  feedback                UserFeedback[]
  defectiveItemReports    DefectiveItemReport[]

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete
  closedAt  DateTime? @map("closed_at") // üyeliğin sonlandırıldığı (SUSPENDED/DELETED) an
  isTest    Boolean   @default(false) @map("is_test") // test/demo hesabı → admin listesinde varsayılan gizli

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

/// User accounts - multi-tenant
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  email         String    @map("email")
  fullName      String?   @map("full_name")
  passwordHash  String    @map("password_hash")
  role          UserRole?
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")
  lastLoginAt   DateTime? @map("last_login_at")

  // Relations
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                 Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  stockMovements         StockMovement[]
  approvedOrders         PurchaseOrder[]        @relation("POApprover")
  requestedTransfers     StockTransfer[]        @relation("TransferRequester")
  approvedTransfers      StockTransfer[]        @relation("TransferApprover")
  dispatchedTransfers    StockTransfer[]        @relation("TransferDispatcher")
  receivedTransfers      StockTransfer[]        @relation("TransferReceiver")
  ocrScansAsScanner      OcrScan[]              @relation("OcrScanner")
  ocrScansAsConfirmer    OcrScan[]              @relation("OcrConfirmer")
  syncQueues             SyncQueue[]            @relation("SyncQueueCreator")
  reviewedUploads        SupplierPortalUpload[] @relation("PortalReviewer")
  priceChangeLogs        PriceChangeLog[]
  openedCashierSessions  CashierSession[]
  createdDebts           Debt[]
  debtPayments           DebtPayment[]
  feedback               UserFeedback[]
  createdDefectiveItems  DefectiveItemReport[]  @relation("DefectiveItemCreator")
  resolvedDefectiveItems DefectiveItemReport[]  @relation("DefectiveItemResolver")

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([branchId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

/// Business branches/locations
model Branch {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  name                 String
  slug                 String    @map("slug")
  address              String?
  phone                String?
  timezone             String    @default("UTC")
  closingTime          String    @default("00:00") @map("closing_time") // HH:mm — günlük raporun gün sınırı
  isActive             Boolean   @default(true) @map("is_active")
  debtsLastViewedAt    DateTime? @map("debts_last_viewed_at")
  debtRemindersEnabled Boolean   @default(true) @map("debt_reminders_enabled")

  // Relations
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                   User[]
  staffRegistrationTokens StaffRegistrationToken[]
  integration             BranchIntegration?
  stockLevels             StockLevel[]
  stockMovements          StockMovement[]
  branchSuppliers         BranchSupplier[]
  purchaseOrders          PurchaseOrder[]
  transfersFrom           StockTransfer[]          @relation("TransferFrom")
  transfersTo             StockTransfer[]          @relation("TransferTo")
  whatsappMessageLogs     WhatsappMessageLog[]
  ocrScans                OcrScan[]
  syncQueues              SyncQueue[]
  supplierPortal          BranchSupplierPortal?
  supplierPortalUploads   SupplierPortalUpload[]
  scheduledReports        ScheduledReport[]
  priceChangeLogs         PriceChangeLog[]
  cashierSessions         CashierSession[]
  debts                   Debt[]
  defectiveItemReports    DefectiveItemReport[]

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("branches")
}

/// ERP/POS integration config per branch
model BranchIntegration {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  branchId           String    @map("branch_id") @db.Uuid
  adapterType        String    @map("adapter_type")
  agentId            String?   @map("agent_id")
  agentVersion       String?   @map("agent_version")
  apiKeyHash         String?   @map("api_key_hash") // bcrypt hash; ham anahtar yalnız üretim anında Agent'a gösterilir
  webserviceUrl      String?   @map("webservice_url")
  apiKeyEncrypted    String?   @map("api_key_encrypted")
  apiSecretEncrypted String?   @map("api_secret_encrypted")
  pollingIntervalSec Int       @default(10) @map("polling_interval_sec")
  connectionStatus   String    @default("PENDING_INSTALL") @map("connection_status")
  lastReadSyncAt     DateTime? @map("last_read_sync_at")
  lastWriteSyncAt    DateTime? @map("last_write_sync_at")
  errorMessage       String?   @map("error_message")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId])
  @@index([tenantId])
  @@index([connectionStatus])
  @@map("branch_integrations")
}

/// Catalogue of supported ERP/POS adapter definitions
model IntegrationAdapter {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adapterType       String   @unique @map("adapter_type")
  displayName       String   @map("display_name")
  webserviceType    String   @map("webservice_type")
  readEndpoint      String   @map("read_endpoint")
  writeEndpoint     String   @map("write_endpoint")
  authType          String   @map("auth_type")
  fieldMappings     Json     @map("field_mappings")
  supportedVersions String?  @map("supported_versions")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("integration_adapters")
}

/// Staff registration tokens for inviting team members
model StaffRegistrationToken {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  branchId       String           @map("branch_id") @db.Uuid
  token          String           @unique
  applicantName  String?          @map("applicant_name")
  applicantEmail String?          @map("applicant_email")
  status         StaffTokenStatus @default(PENDING)
  createdUserId  String?          @map("created_user_id") @db.Uuid
  approvedBy     String?          @map("approved_by") @db.Uuid
  approvedAt     DateTime?        @map("approved_at")
  usedAt         DateTime?        @map("used_at")
  cancelledBy    String?          @map("cancelled_by") @db.Uuid
  cancelledAt    DateTime?        @map("cancelled_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, status])
  @@index([tenantId])
  @@map("staff_registration_tokens")
}

/// Agent kurulum kodu — Agent (yerel Windows servisi) tek kullanımlık bu kodla
/// kendini şubeye bağlar. İlişki alanı yok; tenantId/branchId salt scalar.
model AgentSetupToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  token       String    @unique
  adapterType String    @map("adapter_type")
  status      String    @default("PENDING")
  usedAt      DateTime? @map("used_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([branchId, status])
  @@map("agent_setup_tokens")
}

// ============================================
// PRODUCT CATALOGUE
// ============================================

/// Product categories — supports one level of nesting via self-relation
model Category {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  name     String
  slug     String

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

/// Tenant-level product catalogue
model Product {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  categoryId   String    @map("category_id") @db.Uuid
  sku          String
  barcode      String?
  name         String
  unit         String
  unitsPerCase Int?      @map("units_per_case")
  salePrice    Decimal?  @map("sale_price") @db.Decimal(12, 2)
  variants     Json      @default("[]")
  imageUrl     String?   @map("image_url")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  category             Category              @relation(fields: [categoryId], references: [id])
  stockLevels          StockLevel[]
  stockMovements       StockMovement[]
  purchaseOrderItems   PurchaseOrderItem[]
  stockTransfers       StockTransfer[]
  priceChangeLogs      PriceChangeLog[]
  defectiveItemReports DefectiveItemReport[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, barcode])
  @@map("products")
}

// ============================================
// STOCK
// ============================================

/// Current stock quantity per product per branch
model StockLevel {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  branchId          String    @map("branch_id") @db.Uuid
  quantity          Decimal   @default(0) @db.Decimal(12, 3)
  reservedQty       Decimal   @default(0) @map("reserved_qty") @db.Decimal(12, 3)
  minThreshold      Decimal   @map("min_threshold") @db.Decimal(12, 3)
  maxThreshold      Decimal?  @map("max_threshold") @db.Decimal(12, 3)
  maxThresholdSet   Boolean   @default(false) @map("max_threshold_set")
  maxThresholdSetAt DateTime? @map("max_threshold_set_at")
  thresholdSource   String    @default("AUTO") @map("threshold_source")
  version           Int       @default(0)
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
  @@index([tenantId])
  @@index([branchId, quantity])
  @@map("stock_levels")
}

/// Immutable log of every stock change
model StockMovement {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  movementType     String   @map("movement_type")
  quantity         Decimal  @db.Decimal(12, 3)
  referenceId      String?  @map("reference_id") @db.Uuid
  referenceType    String?  @map("reference_type")
  notes            String?
  photoUrl         String?  @map("photo_url")
  unitPrice        Decimal? @map("unit_price") @db.Decimal(12, 2)
  paymentMethod    String?  @map("payment_method")
  cashierSessionId String?  @map("cashier_session_id") @db.Uuid
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  branch  Branch          @relation(fields: [branchId], references: [id])
  user    User            @relation(fields: [createdBy], references: [id])
  session CashierSession? @relation(fields: [cashierSessionId], references: [id])

  @@index([branchId, createdAt(sort: Desc)])
  @@index([productId, branchId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

/// Geçici Kasa açılış/kapanış oturumu — satışları oturuma bağlar.
model CashierSession {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  branchId String    @map("branch_id") @db.Uuid
  openedBy String    @map("opened_by") @db.Uuid
  openedAt DateTime  @default(now()) @map("opened_at")
  closedAt DateTime? @map("closed_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  branch         Branch          @relation(fields: [branchId], references: [id])
  opener         User            @relation(fields: [openedBy], references: [id])
  stockMovements StockMovement[]

  @@index([branchId, openedAt(sort: Desc)])
  @@map("cashier_sessions")
}

/// Tedarikçi ↔ işletme borç/alacak kaydı.
model Debt {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  supplierId          String    @map("supplier_id") @db.Uuid
  direction           String // 'PAYABLE' (işletme borçlu) | 'RECEIVABLE' (tedarikçi borçlu)
  debtType            String    @default("CASH") @map("debt_type") // 'CASH' | 'PRODUCT'
  source              String    @default("MANUAL") @map("source") // 'MANUAL' | 'OCR'
  amount              Decimal?  @db.Decimal(12, 2) // nakit borçlarda dolu, ürün borçlarında null
  remainingAmount     Decimal?  @map("remaining_amount") @db.Decimal(12, 2) // CASH için, oluşturulunca amount'a eşitlenir
  lastPaymentAmount   Decimal?  @map("last_payment_amount") @db.Decimal(12, 2)
  lastPaymentDate     DateTime? @map("last_payment_date")
  paidAt              DateTime? @map("paid_at") // tam kapandığı an, 3-gün gösterim için
  productDescription  String?   @map("product_description") // backend otomatik özet metin
  productLines        Json?     @map("product_lines") // [{ productId, productName, quantity, unit, receivedQuantity }]
  affectsStock        Boolean   @default(false) @map("affects_stock") // true ise teslim alındıkça productLines stoka geri eklenir
  invoiceDate         DateTime? @map("invoice_date")
  dueDate             DateTime? @map("due_date")
  status              String    @default("OPEN") // OPEN | PAID
  notes               String?
  lastReminderShownAt DateTime? @map("last_reminder_shown_at")
  createdBy           String    @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  branch   Branch        @relation(fields: [branchId], references: [id])
  supplier Supplier      @relation(fields: [supplierId], references: [id])
  creator  User          @relation(fields: [createdBy], references: [id])
  payments DebtPayment[]

  @@index([branchId, status])
  @@map("debts")
}

/// Bir borç kaydına ait tekil ödeme hareketi (ilk fatura ödemesi dahil).
model DebtPayment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  debtId    String   @map("debt_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @default(now()) @map("paid_at")
  createdBy String   @map("created_by") @db.Uuid

  debt    Debt @relation(fields: [debtId], references: [id])
  creator User @relation(fields: [createdBy], references: [id])

  @@index([debtId, paidAt])
  @@map("debt_payments")
}

/// Ürün Zayiatları (isletme-app, yalnızca tek şubeli/STARTER PATRON) — defolu/
/// kullanılamaz bir ürün fotoğraflanıp stoktan hemen düşülür (PENDING), sonra
/// kullanıcı "Ziyan Oldu" (kalıcı zayiat) ya da "Değişim Gerçekleşti" (stoğa
/// geri eklenir) der. Fire (StockMovement:'WASTE', recordWaste) ile aynı
/// amaca hizmet eden ama TAMAMEN AYRI bir akış — birbirine dokunmaz.
model DefectiveItemReport {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  quantity    Decimal   @db.Decimal(12, 3)
  // Gerçek foto verisi (base64, sıkıştırılmış — max 1200px/JPEG 0.8). Projenin
  // geri kalanındaki "sahte URL üret" deseni KASITLI OLARAK burada kullanılmıyor.
  photoBase64 String    @map("photo_base64")
  status      String    @default("PENDING") // PENDING | WASTED | EXCHANGED
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by") @db.Uuid

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  branch   Branch  @relation(fields: [branchId], references: [id])
  product  Product @relation(fields: [productId], references: [id])
  creator  User    @relation("DefectiveItemCreator", fields: [createdBy], references: [id])
  resolver User?   @relation("DefectiveItemResolver", fields: [resolvedBy], references: [id])

  @@index([branchId, status])
  @@map("defective_item_reports")
}

// ============================================
// SUPPLIERS & PURCHASE ORDERS
// ============================================

/// Supplier/vendor master data
model Supplier {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String
  contactName       String?   @map("contact_name")
  whatsappNumber    String    @map("whatsapp_number")
  otpVerified       Boolean   @default(false) @map("otp_verified")
  otpVerifiedAt     DateTime? @map("otp_verified_at")
  productCategories Json      @default("[]") @map("product_categories")
  notes             String?
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")

  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  branchSuppliers     BranchSupplier[]
  purchaseOrders      PurchaseOrder[]
  whatsappMessageLogs WhatsappMessageLog[]
  portalUploads       SupplierPortalUpload[]
  debts               Debt[]

  @@index([tenantId])
  @@map("suppliers")
}

/// Junction: which branches work with which suppliers
model BranchSupplier {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  branch   Branch   @relation(fields: [branchId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([branchId, supplierId])
  @@index([branchId, isPrimary])
  @@map("branch_suppliers")
}

/// Purchase order header
model PurchaseOrder {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  branchId   String    @map("branch_id") @db.Uuid
  supplierId String    @map("supplier_id") @db.Uuid
  status     String    @default("DRAFT")
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  branch              Branch               @relation(fields: [branchId], references: [id])
  supplier            Supplier             @relation(fields: [supplierId], references: [id])
  approver            User?                @relation("POApprover", fields: [approvedBy], references: [id])
  items               PurchaseOrderItem[]
  whatsappMessageLogs WhatsappMessageLog[]

  @@index([tenantId])
  @@index([branchId, status])
  @@map("purchase_orders")
}

/// Purchase order line items
model PurchaseOrderItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poId             String   @map("po_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  quantityOrdered  Decimal  @map("quantity_ordered") @db.Decimal(12, 3)
  quantityReceived Decimal  @default(0) @map("quantity_received") @db.Decimal(12, 3)
  unitPrice        Decimal? @map("unit_price") @db.Decimal(12, 2)
  notes            String?

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@map("purchase_order_items")
}

// ============================================
// STOCK TRANSFERS
// ============================================

/// Inter-branch stock transfer lifecycle: REQUESTED→APPROVED→IN_TRANSIT→DELIVERED
model StockTransfer {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  fromBranchId String    @map("from_branch_id") @db.Uuid
  toBranchId   String    @map("to_branch_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  quantity     Decimal   @db.Decimal(12, 3)
  status       String    @default("REQUESTED")
  requestedBy  String    @map("requested_by") @db.Uuid
  approvedBy   String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  dispatchedBy String?   @map("dispatched_by") @db.Uuid
  dispatchedAt DateTime? @map("dispatched_at")
  receivedBy   String?   @map("received_by") @db.Uuid
  receivedAt   DateTime? @map("received_at")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  fromBranch Branch  @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch  @relation("TransferTo", fields: [toBranchId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
  requester  User    @relation("TransferRequester", fields: [requestedBy], references: [id])
  approver   User?   @relation("TransferApprover", fields: [approvedBy], references: [id])
  dispatcher User?   @relation("TransferDispatcher", fields: [dispatchedBy], references: [id])
  receiver   User?   @relation("TransferReceiver", fields: [receivedBy], references: [id])

  @@index([tenantId])
  @@index([fromBranchId, status])
  @@index([toBranchId, status])
  @@map("stock_transfers")
}

// ============================================
// WHATSAPP NOTIFICATIONS
// ============================================

model WhatsappMessageLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  supplierId     String    @map("supplier_id") @db.Uuid
  poId           String    @map("po_id") @db.Uuid
  messageBody    String    @map("message_body")
  whatsappNumber String    @map("whatsapp_number")
  status         String    @default("PENDING")
  sentAt         DateTime? @map("sent_at")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  branch   Branch        @relation(fields: [branchId], references: [id])
  supplier Supplier      @relation(fields: [supplierId], references: [id])
  order    PurchaseOrder @relation(fields: [poId], references: [id])

  @@index([tenantId])
  @@index([poId, status])
  @@map("whatsapp_message_logs")
}

// ============================================
// OCR SCANS
// ============================================

model OcrScan {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  scannedBy    String    @map("scanned_by") @db.Uuid
  imageUrl     String    @map("image_url")
  rawOcrResult Json?     @map("raw_ocr_result")
  parsedLines  Json?     @map("parsed_lines")
  status       String    @default("PENDING")
  confirmedBy  String?   @map("confirmed_by") @db.Uuid
  confirmedAt  DateTime? @map("confirmed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  branch    Branch @relation(fields: [branchId], references: [id])
  scanner   User   @relation("OcrScanner", fields: [scannedBy], references: [id])
  confirmer User?  @relation("OcrConfirmer", fields: [confirmedBy], references: [id])

  @@index([tenantId])
  @@index([branchId, status])
  @@map("ocr_scans")
